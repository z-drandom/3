# ---- EHS 知识库 环境变量样例 ----
# Linux: 复制为 /etc/ehs-kb.env ；Windows: 用 nssm 的 AppEnvironmentExtra 设置

# 知识库根目录（“文件即数据库”的唯一数据源）
EHS_DOCS_ROOT=/srv/ehs/docs
# Windows 示例： EHS_DOCS_ROOT=D:\ehs\docs

# 管理视图口令（同事只读无需登录；输入此口令才进入管理视图）
EHS_ADMIN_TOKEN=Change-Me-2026-EHS

# 监听地址与端口（0.0.0.0 表示内网任意网卡可访问）
EHS_HOST=0.0.0.0
EHS_PORT=8080

# 回收站保留天数，0 表示永不清理
EHS_TRASH_RETAIN_DAYS=90

# 到期提醒阈值（天）
EHS_REVIEW_WARN_DAYS=30
